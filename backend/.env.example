# Copy to backend/.env for local development:  cp .env.example .env
KIVI_ENV=development
KIVI_DATABASE_URL=postgresql+psycopg://kivi:kivi@127.0.0.1:5433/kivi

# Required in production: a random string of at least 32 characters.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
KIVI_SECRET_KEY=dev-only-insecure-secret-change-me
KIVI_COOKIE_SECURE=false

# HMAC key for watchlist digests (defaults to KIVI_SECRET_KEY). Set it separately in
# production: changing it makes existing watchlist entries unmatchable.
# KIVI_LIST_KEY=

# approval: sign-ups wait for an administrator; open: active immediately; closed: disabled
KIVI_SIGNUP_MODE=approval

# Password for the demo accounts created by "kivi-ui seed-demo"
# (admin / analyst, plus a pending sign-up "newcomer"). Local development only.
KIVI_DEMO_PASSWORD=Kivib854d4622026
